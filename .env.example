# PostgreSQL container
POSTGRES_DB=iuh_regrag
POSTGRES_USER=iuh_regrag
POSTGRES_PASSWORD=replace_with_a_local_database_password
POSTGRES_PORT=5432

# Backend database connection
DB_URL=jdbc:postgresql://localhost:5432/iuh_regrag
DB_USERNAME=iuh_regrag
DB_PASSWORD=replace_with_the_same_local_database_password

# Python data pipeline database connection
PIPELINE_DATABASE_URL=postgresql://iuh_regrag:replace_with_the_same_local_database_password@localhost:5432/iuh_regrag

# Authentication
JWT_SECRET=replace_with_at_least_32_random_characters
FRONTEND_ORIGIN=http://localhost:5173
CHAT_RATE_LIMIT_PER_MINUTE=20

# LLM generation: Gemini primary, local Ollama fallback
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TIMEOUT_SECONDS=30
GEMINI_API_KEY=replace_with_a_new_gemini_api_key
LLM_FALLBACK_ENABLED=true
LLM_FALLBACK_PROVIDER=ollama
LLM_FALLBACK_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434

# Python AI service called by the Spring backend
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_SECONDS=120

# Local embedding model
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_MAX_TOKENS=8192
EMBEDDING_BATCH_SIZE=4
EMBEDDING_DEVICE=auto

# Cross-encoder reranker
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_MAX_TOKENS=1024
RERANK_BATCH_SIZE=8
RERANK_DEVICE=auto
RERANK_MIN_SCORE=0.05
